# Für die lokale Entwicklung als .env.local kopieren und ausfüllen (.env.local wird nicht committet).
# Werte aus Supabase: Project Settings → API (Project URL und anon/publishable key – NICHT den service_role/secret key).
# Ohne diese Werte läuft die App rein lokal ohne Anmeldung.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_KEY=
